@startuml
skinparam backgroundColor transparent
skinparam shadowing false
skinparam defaultFontName Arial
skinparam activity {
  BackgroundColor #F8F9FA
  BorderColor #495057
  DiamondBackgroundColor #FFF3BF
  DiamondBorderColor #E67700
  StartColor #2B8A3E
  EndColor #C92A2A
  BarColor #495057
  FontColor #212529
}
skinparam ArrowColor #495057
skinparam NoteBackgroundColor #FFF9DB
skinparam NoteBorderColor #E67700

title Danh mục Activity Diagram của hệ thống PHS CRM

start
:01. Đăng nhập và điều hướng theo quyền;
:02. Tạo người dùng và cấp quyền;
:03. Tạo khách hàng / doanh nghiệp và tài khoản;
:04. Tạo Ticket thủ công;
:05. Tiếp nhận, phân công và xử lý Ticket;
:06. Quét SLA, cảnh báo và tự đóng Ticket;
:07. Đồng bộ Chatbot và tự động tạo Ticket;
:08. Import và phân loại lỗi bên ngoài;
:09. Ghi nhận cuộc gọi Sale Admin;
:10. Khởi tạo và kích hoạt kỳ KPI;
:11. Thiết lập chỉ tiêu KPI;
:12. Tính điểm và xếp hạng KPI;
:13. Quản lý, import và chăm sóc eKYC;
:14. Tiếp nhận và xử lý Failed eKYC;
:15. Ghi nhận và quản lý khảo sát CSAT;
stop
@enduml
