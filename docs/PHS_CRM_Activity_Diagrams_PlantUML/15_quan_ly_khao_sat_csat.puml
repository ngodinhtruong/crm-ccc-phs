@startuml
skinparam backgroundColor transparent
skinparam shadowing false
skinparam defaultFontName Arial
skinparam activity {
  BackgroundColor #F8F9FA
  BorderColor #495057
  DiamondBackgroundColor #FFF3BF
  DiamondBorderColor #E67700
  StartColor #2B8A3E
  EndColor #C92A2A
  BarColor #495057
  FontColor #212529
}
skinparam ArrowColor #495057
skinparam NoteBackgroundColor #FFF9DB
skinparam NoteBorderColor #E67700

title Activity 15 - Ghi nhận và quản lý khảo sát CSAT

|Nhân viên CCC / Admin|
start
:Mở phân hệ Khảo sát;

|Frontend Next.js|
:Gọi API lấy hồ sơ người dùng;
|Backend Survey|
:Kiểm tra quyền nhập khảo sát
và phạm vi ticket được xem;
if (Được phép truy cập?) then (Có)
else (Không)
  :Trả lỗi 403;
  |Frontend Next.js|
  :Hiển thị không có quyền truy cập;
  stop
endif

|Nhân viên CCC / Admin|
if (Nguồn dữ liệu?) then (Nhập thủ công)
  :Nhập tên khách hàng, số điện thoại
  và thời điểm gửi;
  |Frontend Next.js|
  :Tra cứu ticket của khách hàng
  trong tháng gửi khảo sát;
  |Backend Survey|
  :Lọc ticket theo quyền người dùng;
  :Đánh dấu ticket đã có khảo sát thành công;
  |Frontend Next.js|
  :Hiển thị danh sách ticket phù hợp;
  |Nhân viên CCC / Admin|
  :Chọn ticket;
  :Nhập trạng thái gửi, điểm
  và mô tả đánh giá;
  note right
    Điểm trống là chưa phản hồi.
    Điểm 0 là khách chấm 0 điểm.
  end note
  |Frontend Next.js|
  :Kiểm tra dữ liệu và gửi yêu cầu tạo;

else (Import Excel)
  :Chọn file khảo sát Excel;
  |Frontend Next.js|
  :Gửi file để xem trước;
  |Backend Survey|
  :Đọc file và chuẩn hóa từng dòng;
  :Tách số điện thoại từ tên tin nhắn nếu cần;
  :Tìm ticket của khách trong tháng gửi;
  :Gợi ý ticket khi chỉ có một lựa chọn hợp lệ;
  |Frontend Next.js|
  :Hiển thị dữ liệu xem trước;
  |Nhân viên CCC / Admin|
  :Kiểm tra và chọn ticket cho từng dòng;
  |Frontend Next.js|
  :Gửi danh sách xác nhận import;
endif

|Backend Survey|
while (Còn dòng cần ghi?) is (Có)
  :Kiểm tra ticket tồn tại và có quyền xem;
  if (Ticket đã khảo sát thành công?) then (Có)
    :Ghi lỗi ticket đã hoàn tất khảo sát;
  else (Không)
    :Chuẩn hóa trạng thái gửi và điểm;
    :Lưu TicketSurveyLog;
    if (Gửi thành công?) then (Có)
      :Tạo hoặc cập nhật TicketFeedback;
      if (Có điểm đánh giá?) then (Có)
        :Đặt trạng thái RESPONDED;
      else (Không)
        :Đặt trạng thái SENT;
      endif
    else (Thất bại)
      :Không tạo kết quả chính thức;
      :Cho phép gửi khảo sát lại;
    endif
    :Tạo Audit Log CREATE;
  endif
endwhile (Không)

|Frontend Next.js|
:Hiển thị kết quả ghi nhận hoặc import;
:Hiển thị danh sách, bộ lọc và phân trang;

|Nhân viên CCC / Admin|
if (Tác vụ tiếp theo?) then (Cập nhật)
  :Sửa trạng thái gửi, thời điểm,
  điểm hoặc mô tả;
  |Backend Survey|
  :Cập nhật Survey và TicketFeedback;
  :Lưu trường thay đổi, người sửa
  và lý do vào Audit Log;
  |Frontend Next.js|
  :Hiển thị chi tiết và lịch sử chỉnh sửa;
elseif (Dashboard) then (Dashboard)
  |Backend Survey|
  :Tổng hợp số gửi, thành công, thất bại,
  tỷ lệ phản hồi, điểm trung bình và CSAT;
  :So sánh kỳ hiện tại với kỳ trước;
  |Frontend Next.js|
  :Hiển thị KPI và biểu đồ khảo sát;
else (Kết thúc)
endif
stop
@enduml
