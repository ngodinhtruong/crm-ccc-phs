@startuml
skinparam backgroundColor transparent
skinparam shadowing false
skinparam defaultFontName Arial
skinparam activity {
  BackgroundColor #F8F9FA
  BorderColor #495057
  DiamondBackgroundColor #FFF3BF
  DiamondBorderColor #E67700
  StartColor #2B8A3E
  EndColor #C92A2A
  BarColor #495057
  FontColor #212529
}
skinparam ArrowColor #495057
skinparam NoteBackgroundColor #FFF9DB
skinparam NoteBorderColor #E67700

title Activity 07 - Đồng bộ Chatbot và tự động tạo Ticket

|Celery Beat|
start
:Kích hoạt task đồng bộ Chatbot;

|Celery Worker|
:Thử lấy khóa đồng bộ;
if (Task khác đang chạy?) then (Có)
  :Bỏ qua lần đồng bộ;
  stop
else (Không)
endif

|Supabase|
:Trả ChatLog, ChatbotState và CSKH Request mới;

|Backend Chatbot|
:Upsert dữ liệu theo external_id;
:Tập hợp các session_id bị thay đổi;
:Nhóm log, state và request theo session;
while (Còn session cần tổng hợp?) is (Có)
  if (Có CSKH Request?) then (Có)
    :Gán outcome = CCC;
  elseif (Có ChatbotState?) then (Có)
    :Gán outcome = PENDING;
  elseif (Phiên chỉ gồm câu spam?) then (Có)
    :Gán outcome = SPAM;
  else (Không)
    :Gán outcome = BOT_DONE;
  endif
  :Tạo / cập nhật ChatbotSessionSummary;

  if (Outcome = CCC?) then (Có)
    if (Session đã liên kết Ticket?) then (Có)
      :Giữ Ticket hiện có;
    else (Không)
      :Tìm khách hàng theo tài khoản / điện thoại / email;
      :Xây dựng nội dung hội thoại đầy đủ;
      |Backend Ticket|
      :Tạo Ticket nguồn Chatbot;
      :Đặt trạng thái CREATED;
      :Đưa vào hàng chờ CCC nếu chưa gán owner;
      |Backend Chatbot|
      :Liên kết session với Ticket;
    endif
  else (Không)
  endif
endwhile (Không)

|Celery Worker|
:Giải phóng khóa;
:Trả thống kê đồng bộ và số Ticket tạo mới;
stop
@enduml
