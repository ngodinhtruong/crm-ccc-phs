@startuml
skinparam backgroundColor transparent
skinparam shadowing false
skinparam defaultFontName Arial
skinparam activity {
  BackgroundColor #F8F9FA
  BorderColor #495057
  DiamondBackgroundColor #FFF3BF
  DiamondBorderColor #E67700
  StartColor #2B8A3E
  EndColor #C92A2A
  BarColor #495057
  FontColor #212529
}
skinparam ArrowColor #495057
skinparam NoteBackgroundColor #FFF9DB
skinparam NoteBorderColor #E67700

title Activity 14 - Tiếp nhận và xử lý Failed eKYC

|Nhân viên CCC / Admin|
start
:Mở phân hệ Failed eKYC;

|Frontend Next.js|
:Gọi API lấy hồ sơ người dùng;
|Backend Django|
:Kiểm tra role Admin / CCC và quyền truy cập;
if (Được phép truy cập?) then (Có)
else (Không)
  :Trả lỗi 403;
  |Frontend Next.js|
  :Hiển thị không có quyền truy cập;
  stop
endif

|Nhân viên CCC / Admin|
if (Nguồn dữ liệu?) then (Nhập thủ công)
  :Chọn Step và nhập thông tin lỗi;
  :Nhập Account, Email, Phone nếu có;
  note right
    Account, Email và Phone
    đều được phép để trống.
  end note
  :Nhập ngày phát sinh, PIC,
  thông tin gọi và CS comment;
  |Frontend Next.js|
  if (Có Account?) then (Có)
    :Gọi API tra cứu khách hàng;
    |Backend Failed eKYC|
    :Liên kết Customer và CustomerAccount nếu tìm thấy;
  else (Không)
  endif
  |Frontend Next.js|
  :Gửi yêu cầu tạo FailedEkycRecord;
  |Backend Failed eKYC|
  :Kiểm tra Step và chuẩn hóa Account;
  :Lưu bản ghi và người tạo;
else (Import Excel)
  |Nhân viên CCC / Admin|
  :Chọn file Failed eKYC;
  |Frontend Next.js|
  :Kiểm tra file và gửi multipart request;
  |Backend Failed eKYC|
  :Kiểm tra dung lượng tối đa 10 MB;
  :Đọc workbook và ánh xạ header;
  while (Còn dòng dữ liệu?) is (Có)
    if (Dòng hoàn toàn trống?) then (Có)
      :Bỏ qua dòng;
    else (Không)
      :Chuẩn hóa Step, ngày phát sinh,
      ngày gọi và số lần follow;
      if (Step hợp lệ?) then (Có)
        if (Có Account?) then (Có)
          :Tra cứu CustomerAccount;
        else (Không)
        endif
        :Cho phép Account, Email, Phone trống;
        :Đưa bản ghi vào danh sách tạo;
      else (Không)
        :Ghi số dòng và lỗi Step;
      endif
    endif
  endwhile (Không)
  :Tạo hàng loạt FailedEkycRecord trong transaction;
  :Trả số dòng thành công và danh sách lỗi;
endif

|Frontend Next.js|
:Hiển thị danh sách và bộ lọc theo từng cột;
:Cho phép export theo bộ lọc;

|Nhân viên CCC / Admin|
:Chọn bản ghi cần chăm sóc;
:Cập nhật PIC, ngày gọi, số lần follow,
tình trạng, kết quả và CS comment;
|Backend Failed eKYC|
:Kiểm tra quyền và cập nhật bản ghi;

|Nhân viên CCC / Admin|
if (Xem Dashboard?) then (Có)
  |Backend Failed eKYC|
  :Lọc theo khoảng ngày và kỳ báo cáo;
  :Tổng hợp liên hệ, kết quả, nhóm lỗi,
  trùng case và hiệu quả theo PIC;
  |Frontend Next.js|
  :Hiển thị KPI và biểu đồ Failed eKYC;
else (Không)
endif
stop
@enduml
