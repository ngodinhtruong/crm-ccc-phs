@startuml
skinparam backgroundColor transparent
skinparam shadowing false
skinparam defaultFontName Arial
skinparam activity {
  BackgroundColor #F8F9FA
  BorderColor #495057
  DiamondBackgroundColor #FFF3BF
  DiamondBorderColor #E67700
  StartColor #2B8A3E
  EndColor #C92A2A
  BarColor #495057
  FontColor #212529
}
skinparam ArrowColor #495057
skinparam NoteBackgroundColor #FFF9DB
skinparam NoteBorderColor #E67700

title Activity 09 - Ghi nhận và cập nhật cuộc gọi Sale Admin

|Nhân viên Sale Admin|
start
:Mở form ghi nhận cuộc gọi;
:Chọn khách hàng và tài khoản;
:Nhập ngày gọi, lần follow, kết quả, mức quan tâm,
ICP, ghi chú và PIC;

|Frontend Next.js|
:Kiểm tra dữ liệu bắt buộc;
if (Dữ liệu hợp lệ?) then (Có)
  :Gửi yêu cầu tạo / cập nhật SA Record;
else (Không)
  :Hiển thị lỗi nhập liệu;
  stop
endif

|Backend Sale Admin|
:Kiểm tra role và permission;
if (Được phép ghi nhận?) then (Có)
else (Không)
  :Trả lỗi 403;
  stop
endif

:Kiểm tra trùng theo tài khoản + PIC + ngày gọi + lần follow;
if (Bị trùng?) then (Có)
  :Trả lỗi bản ghi đã tồn tại;
  |Frontend Next.js|
  :Hiển thị lỗi trùng;
  stop
else (Không)
endif

|Cơ sở dữ liệu|
if (Thao tác?) then (Tạo mới)
  :Sinh mã SA Record;
  :Lưu bản ghi cuộc gọi;
  :Tạo Audit Log CREATE;
else (Cập nhật)
  :Lưu giá trị trước và sau;
  :Cập nhật bản ghi;
  :Tạo Audit Log UPDATE;
endif

|Backend KPI|
:Gửi yêu cầu tính lại KPI của PIC trong kỳ liên quan;
:Tính lại Actual Value / Score nếu kỳ đang hoạt động;

|Backend Sale Admin|
:Trả bản ghi mới nhất;
|Frontend Next.js|
:Hiển thị thông báo thành công;
:Chuyển đến chi tiết / danh sách SA Record;
stop
@enduml
