@startuml
skinparam backgroundColor transparent
skinparam shadowing false
skinparam defaultFontName Arial
skinparam activity {
  BackgroundColor #F8F9FA
  BorderColor #495057
  DiamondBackgroundColor #FFF3BF
  DiamondBorderColor #E67700
  StartColor #2B8A3E
  EndColor #C92A2A
  BarColor #495057
  FontColor #212529
}
skinparam ArrowColor #495057
skinparam NoteBackgroundColor #FFF9DB
skinparam NoteBorderColor #E67700

title Activity 03 - Tạo khách hàng / doanh nghiệp và tài khoản lưu ký

|Nhân viên|
start
:Mở màn hình tạo mới;
if (Loại đối tượng?) then (Khách hàng cá nhân)
  :Nhập mã KH, họ tên, liên hệ, chi nhánh và PIC;
else (Doanh nghiệp)
  :Nhập mã công ty, tên, liên hệ, chi nhánh và PIC;
endif
:Nhập số tài khoản lưu ký nếu có;

|Frontend Next.js|
:Kiểm tra dữ liệu bắt buộc và định dạng;
if (Dữ liệu hợp lệ?) then (Có)
  :Gửi yêu cầu tạo mới;
else (Không)
  :Hiển thị lỗi nhập liệu;
  stop
endif

|Backend Django|
:Kiểm tra quyền tạo khách hàng;
:Kiểm tra mã khách hàng / mã công ty trùng;
if (Mã đã tồn tại?) then (Có)
  :Trả lỗi trùng dữ liệu;
  |Frontend Next.js|
  :Hiển thị lỗi;
  stop
else (Không)
endif

|Backend Django|
if (Có số tài khoản?) then (Có)
  :Chuẩn hóa và kiểm tra số tài khoản;
  if (Số tài khoản đã tồn tại?) then (Có)
    :Trả lỗi trùng số tài khoản;
    |Frontend Next.js|
    :Hiển thị lỗi;
    stop
  else (Không)
  endif
else (Không)
endif

|Cơ sở dữ liệu|
:Tạo Customer hoặc Company;
if (Có số tài khoản?) then (Có)
  :Tạo CustomerAccount;
else (Không)
endif
:Lưu quan hệ chi nhánh và nhân viên phụ trách;

|Backend Django|
:Trả dữ liệu đối tượng vừa tạo;
|Frontend Next.js|
:Hiển thị thông báo thành công;
:Chuyển đến danh sách / trang chi tiết;
stop
@enduml
