@startuml
skinparam backgroundColor transparent
skinparam shadowing false
skinparam defaultFontName Arial
skinparam activity {
  BackgroundColor #F8F9FA
  BorderColor #495057
  DiamondBackgroundColor #FFF3BF
  DiamondBorderColor #E67700
  StartColor #2B8A3E
  EndColor #C92A2A
  BarColor #495057
  FontColor #212529
}
skinparam ArrowColor #495057
skinparam NoteBackgroundColor #FFF9DB
skinparam NoteBorderColor #E67700

title Activity 11 - Thiết lập chỉ tiêu KPI cho nhân viên

|KPI Admin / SA Supervisor|
start
:Chọn kỳ KPI và Profile;

|Frontend Next.js|
:Gọi API lấy ma trận nhân viên x Metric;

|Backend KPI|
:Kiểm tra scope quản lý;
:Lấy danh sách nhân viên thuộc phạm vi;
:Lấy Metric có thể đặt target;
:Trả ma trận chỉ tiêu;

|KPI Admin / SA Supervisor|
if (Cách thiết lập?) then (Nhập trực tiếp)
  :Nhập Target Value và ghi chú cho từng ô;
elseif (Sao chép kỳ trước) then (Kỳ trước)
  :Chọn sao chép target từ kỳ trước;
else (Nhân viên mẫu)
  :Chọn nhân viên nguồn và nhân viên đích;
endif
:Bấm lưu hàng loạt;

|Frontend Next.js|
:Kiểm tra số liệu và gửi bulk update / copy request;

|Backend KPI|
:Kiểm tra permission KPI_TARGET_MANAGE;
if (Có quyền?) then (Có)
else (Không)
  :Trả lỗi 403;
  stop
endif
:Kiểm tra kỳ có cho phép chỉnh target;
if (Được chỉnh?) then (Có)
else (Không)
  :Trả lỗi kỳ đã khóa / đóng;
  stop
endif
:Kiểm tra nhân viên và Metric thuộc đúng Profile / scope;
if (Dữ liệu hợp lệ?) then (Có)
  :Tạo mới hoặc cập nhật KPI Target;
  :Ghi người cập nhật và thời điểm;
else (Không)
  :Trả chi tiết dòng / ô bị lỗi;
  stop
endif

|Frontend Next.js|
:Tải lại ma trận chỉ tiêu;
:Hiển thị kết quả cập nhật;
stop
@enduml
